 type grokSlowTTFTQuarantineStat struct {
 	mu          sync.Mutex
 	consecutive int
@@ -215,15 +235,26 @@ func isActiveGrokSlowTTFTModelRateLimit(account *Account, now time.Time) bool {
 	if !ok {
 		return false
